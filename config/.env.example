# ── MCP (Model Context Protocol) ──────────────────────
# Servidores MCP externos (filesystem, github, gitlab, etc.)
# Configurados em config/mcp_servers.json (estilo Claude Desktop)
# Uso:
#   /mcp                                → lista servidores conectados
#   /mcp filesystem                     → lista tools
#   /mcp filesystem list_directory {"path": "C:/..."}  → executa tool
#   [MCP_CALL: "filesystem|read_file|{...}"]           → tag no Active Loop
#
# Servidores populares (stdio transport, requer npx/uvx):
#   - npx -y @modelcontextprotocol/server-filesystem
#   - npx -y @modelcontextprotocol/server-github
#   - npx -y @modelcontextprotocol/server-gitlab
#   - uvx mcp-server-fetch
MCP_SERVERS_CONFIG=""  # path alternativo (default: config/mcp_servers.json)



# ── MCP SERVER (v3.11) — Seeker.Bot como servidor MCP ──────────
# Bearer token para clientes MCP remotos (opencode, Claude Desktop).
# Loopback (127.0.0.1) NAO exige token — uso local sem fricção.
# Conexoes remotas exigem: Authorization: Bearer <key>
#
# Endpoints expostos na mesma porta do RPC (RPC_PORT, default 8001):
#   POST /mcp            Streamable HTTP (MCP spec 2024-11-05+)
#   GET  /mcp/sse        Legacy SSE transport
#   POST /mcp/messages   Endpoint de mensagens do SSE legacy
#
# Tools expostas: read_file, write_file, patch_file, execute_command,
# execute_code, read_session, record_session_turn
# Resources: session://{session_id}
# Prompts: summarize_session, compare_sessions
#
# Como conectar no opencode:
#   { "mcp": { "seeker": { "type": "remote", "url": "http://HOST:PORT/mcp",
#                "headers": { "Authorization": "Bearer <key>" } } } }
#
# Regenerar token: python -c "import secrets; print(secrets.token_urlsafe(32))"
SEEKER_MCP_API_KEY=

# ── WHATSAPP VAULT (v3.12) — só preencha se for usar ─────
# Gere token em http://localhost:8080/manager → API Key (Settings → Global API Key).
# O Seeker cria o config/whatsapp.yaml sozinho na primeira execução via /wa_config.
EVOLUTION_BASE_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="seeker-main"
WHATSAPP_OWN_NUMBER=""     # seu próprio número WhatsApp (ex: 5511999999999) p/ dedup
